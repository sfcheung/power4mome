m ~ x
y ~ m + x
"

# Specify the population values

mod_es <-
"
y ~ m: l
m ~ x: s
y ~ x: m
"

# Simulate the data

sim_only <- power4test(
  nrep = 2,
  model = mod,
  pop_es = mod_es,
  n = 100,
  iseed = 1234
)

# Do the tests in each replication

mod_complete <-
"
m ~ x
y ~ m
"

test_out <- power4test(
  object = sim_only,
  test_fun = test_fit_measure,
  test_args = list(
    model_to_fit = mod_complete,
    fit_measure = "cfi",
    sig_if = "<.90"
  )
)

print(test_out,
      test_long = TRUE)


}
